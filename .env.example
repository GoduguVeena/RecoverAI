# RecoverAI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=recoverai_db
POSTGRES_USER=recoverai_user
POSTGRES_PASSWORD=recoverai_password
POSTGRES_PORT=5432

# ─── Service Ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8080
ML_SERVICE_PORT=8000
FRONTEND_PORT=3000

# ─── AI Agent (optional) ──────────────────────────────────────────────────────
# If absent, the backend uses FakeAgentModelClient as a deterministic fallback.
GEMINI_API_KEY=

# ─── Razorpay Webhook ─────────────────────────────────────────────────────────
# Set this to your Razorpay webhook secret for signature verification.
# For local/demo use, any non-empty string works.
RAZORPAY_WEBHOOK_SECRET=recoverai_webhook_secret_demo

# ─── Execution Mode ───────────────────────────────────────────────────────────
# DRY_RUN is the only supported mode. Do NOT change this.
RECOVERAI_EXECUTION_MODE=DRY_RUN
